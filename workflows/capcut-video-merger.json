{
  "name": "CapCut Video Merger Workflow",
  "nodes": [
    {
      "parameters": {},
      "id": "start-node",
      "name": "When clicking Test workflow",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Sheet1",
          "mode": "name"
        },
        "options": {}
      },
      "id": "google-sheets-node",
      "name": "Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [440, 300],
      "notes": "Reads video URLs from Google Sheets\n\nExpected columns:\n- video_url (required)\n- start_time (optional, default: 0)\n- end_time (optional, default: 10)"
    },
    {
      "parameters": {
        "jsCode": "// Aggregate all video items and prepare for draft creation\nconst videos = [];\n\nfor (const item of $input.all()) {\n  videos.push({\n    video_url: item.json.video_url,\n    start_time: item.json.start_time || 0,\n    end_time: item.json.end_time || 10\n  });\n}\n\nreturn {\n  videos: videos,\n  videoCount: videos.length\n};"
      },
      "id": "aggregate-videos-node",
      "name": "Aggregate Videos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [640, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:9000/create_draft",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"width\": 1920,\n  \"height\": 1080\n}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        }
      },
      "id": "create-draft-node",
      "name": "Create Draft",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [840, 300],
      "notes": "Creates a CapCut draft (1920x1080)"
    },
    {
      "parameters": {
        "jsCode": "// Combine draft_id with videos array\nconst draftId = $input.first().json.draft_id;\nconst videos = $('Aggregate Videos').first().json.videos;\n\nreturn {\n  draftId: draftId,\n  videos: videos\n};"
      },
      "id": "combine-data-node",
      "name": "Combine Draft and Videos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1040, 300]
    },
    {
      "parameters": {
        "jsCode": "// Split videos array into individual items\nconst draftId = $input.first().json.draftId;\nconst videos = $input.first().json.videos;\n\nreturn videos.map(video => ({\n  draftId: draftId,\n  ...video\n}));"
      },
      "id": "split-videos-node",
      "name": "Split Into Items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:9000/add_video",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"draft_id\": \"{{ $json.draftId }}\",\n  \"video_url\": \"{{ $json.video_url }}\",\n  \"start\": {{ $json.start_time }},\n  \"end\": {{ $json.end_time }},\n  \"volume\": 1.0\n}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        }
      },
      "id": "add-video-node",
      "name": "Add Video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1440, 300],
      "notes": "Adds each video to the draft"
    },
    {
      "parameters": {
        "jsCode": "// Aggregate results and extract draft_id for next step\nconst items = $input.all();\nconst draftId = items[0].json.draft_id || $('Combine Draft and Videos').first().json.draftId;\n\nreturn {\n  draftId: draftId,\n  videosAdded: items.length,\n  message: `Successfully added ${items.length} videos to draft ${draftId}`\n};"
      },
      "id": "aggregate-results-node",
      "name": "Aggregate Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1640, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:9000/save_draft",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"draft_id\": \"{{ $json.draftId }}\",\n  \"draft_folder\": \"merged_{{ $now.format('yyyy-MM-dd_HH-mm-ss') }}\"\n}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        }
      },
      "id": "save-draft-node",
      "name": "Save Draft",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1840, 300],
      "notes": "Saves draft and starts processing"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "task_id",
              "name": "taskId",
              "value": "={{ $json.task_id }}",
              "type": "string"
            },
            {
              "id": "draft_id",
              "name": "draftId",
              "value": "={{ $('Aggregate Results').first().json.draftId }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "store-task-id-node",
      "name": "Store Task ID",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.3,
      "position": [2040, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:9000/query_draft_status",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"task_id\": \"{{ $json.taskId }}\"\n}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        }
      },
      "id": "check-status-node",
      "name": "Check Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2240, 300],
      "notes": "Check draft processing status\n\nNote: Manually re-run this node every 10-15 seconds until completed"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "status-completed",
              "leftValue": "={{ $json.status }}",
              "rightValue": "completed",
              "operator": {
                "type": "string",
                "operation": "equals",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-completed-node",
      "name": "If Completed",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [2440, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "download_url",
              "name": "downloadUrl",
              "value": "={{ $json.video_url || $json.draft_url }}",
              "type": "string"
            },
            {
              "id": "draft_url",
              "name": "draftUrl",
              "value": "={{ $json.draft_url }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "extract-url-node",
      "name": "Extract URL",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.3,
      "position": [2640, 200]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.downloadUrl }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "Mozilla/5.0"
            }
          ]
        }
      },
      "id": "download-video-node",
      "name": "Download Video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2840, 200],
      "notes": "Downloads video as binary data"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "success",
              "name": "status",
              "value": "success",
              "type": "string"
            },
            {
              "id": "message",
              "name": "message",
              "value": "Video merged and downloaded successfully!",
              "type": "string"
            },
            {
              "id": "draft_url",
              "name": "draftUrl",
              "value": "={{ $('Extract URL').item.json.draftUrl }}",
              "type": "string"
            },
            {
              "id": "info",
              "name": "info",
              "value": "Binary video data is in the 'data' field. To save to disk, add a 'Move Binary Data' node or download from workflow output.",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "success-node",
      "name": "Success",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.3,
      "position": [3040, 200]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "status",
              "name": "status",
              "value": "processing",
              "type": "string"
            },
            {
              "id": "message",
              "name": "message",
              "value": "Video is still processing...",
              "type": "string"
            },
            {
              "id": "current_status",
              "name": "currentStatus",
              "value": "={{ $json.status }}",
              "type": "string"
            },
            {
              "id": "task_id",
              "name": "taskId",
              "value": "={{ $('Store Task ID').item.json.taskId }}",
              "type": "string"
            },
            {
              "id": "instruction",
              "name": "instruction",
              "value": "Wait 10-15 seconds and re-execute the 'Check Status' node",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "still-processing-node",
      "name": "Still Processing",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.3,
      "position": [2640, 400]
    }
  ],
